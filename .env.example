# Скопируйте в .env (не коммитить) или задайте переменные окружения на хостинге.

# --- Отправка заявок (без этих значений сайт честно предлагает отправить письмо из почтового приложения)
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Подтверждённый в Resend отправитель (домен должен быть верифицирован), например: QADOQLAB <requests@ваш-домен.uz>
MAIL_FROM=
# Получатель(и) через запятую. По умолчанию — qadoqlab.uz@gmail.com из config/site.config.js
MAIL_TO=qadoqlab.uz@gmail.com

# --- Файлы во вложениях (JPG/PNG/PDF, до 3 шт. по 10 МБ). Работает только при настроенной почте.
UPLOADS_ENABLED=false

# --- Сервер
PORT=8080
# true, если сервер стоит за прокси/балансировщиком (для корректного IP в ограничении частоты).
# TRUST_PROXY_HOPS — сколько прокси стоит перед приложением (обычно 1).
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
# true после подключения HTTPS
HSTS=false
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10
# Общий потолок заявок со всех адресов за то же окно — защищает квоту почтового сервиса
FORM_GLOBAL_LIMIT=60

# --- Админ-панель /admin/ (выключена, пока не задан хеш пароля)
# Создать: npm run admin:password  → вставить строку ADMIN_PASSWORD_HASH=...
ADMIN_PASSWORD_HASH=
# Необязательно: постоянный секрет сессий (иначе после перезапуска сервера нужно войти заново)
ADMIN_SESSION_SECRET=
# Папка с правками из панели (настройки, тексты, фото). На хостинге — постоянный диск.
DATA_DIR=./data
